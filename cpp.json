{
    "dependencies":[
        {
            "name":"boost-regex",
            "cmake":{
                "package":{
                    "name":"Boost",
                    "package-components":["regex"]
                },
                "public-libs":["Boost::regex"]
            }
        },
        {
            "name":"boost-serialization",
            "cmake":{
                "package":{
                    "name":"Boost",
                    "package-components":["serialization"]
                },
                "public-libs":["Boost::serialization"]
            }
        },
        {
            "name":"eigen3",
            "cmake":{
                "package":"Eigen3",
                "public-libs":["Eigen3::Eigen"]
            }
        },
        {
            "name":"ixwebsocket",
            "cmake":{
                "package":"ixwebsocket",
                "private-libs":["ixwebsocket::ixwebsocket"]
            }
        },
        {
            "name":"opencv4",
            "cmake":{
                "package":"OpenCV",
                "public-libs":["${OpenCV_LIBS}"]
            },
            "is-dynamic": true
        },
        {
            "name":"openssl",
            "cmake":{
                "package":"OpenSSL",
                "private-libs":["OpenSSL::SSL"]
            }
        },
        {
            "name":"pangolin",
            "cmake":{
                "package":"Pangolin",
                "private-libs":["${Pangolin_LIBRARIES}"]
            }
        }
    ],
    "dirs":{
        "include": "include",
        "src": "src"
    },
    "cmake":[
        {
            "package":"Threads",
            "public-libs":["Threads::Threads"],
            "public-defs":["-DFactoryEngine"]
        }
    ],
    "system-deps":{
        "apt":[
            "libgl1-mesa-dev", "libwayland-dev", "libxkbcommon-dev", "wayland-protocols", "libegl1-mesa-dev",
            "bison", "autoconf", "libtool", "curl", "pkg-config", "libxi-dev", "libxtst-dev", "libxrandr-dev", "nasm", "libgl-dev", "libxmu-dev", "libglu1-mesa-dev", "libudev-dev", {"name": "libltdl-dev", "platform": "arm64"}
        ],
        "python":[
            {
                "interpreter":"/usr/bin/python3",
                "requirements":["jinja2"]
            }
        ]
    }
}